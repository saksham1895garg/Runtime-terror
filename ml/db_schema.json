{
  "prediction_runs": {
    "description": "One automated model execution over the authoritative analysis grid.",
    "required": [
      "id",
      "model_name",
      "model_version",
      "status",
      "trigger_source",
      "total_cells",
      "processed_cells",
      "created_at"
    ],
    "properties": {
      "id": {
        "default": "gen_random_uuid()",
        "description": "Note:\nThis is a Primary Key.<pk/>",
        "format": "uuid",
        "type": "string"
      },
      "model_name": {
        "format": "text",
        "type": "string"
      },
      "model_version": {
        "format": "text",
        "type": "string"
      },
      "status": {
        "default": "QUEUED",
        "format": "text",
        "type": "string"
      },
      "trigger_source": {
        "default": "AUTOMATED",
        "format": "text",
        "type": "string"
      },
      "total_cells": {
        "default": 2271,
        "format": "integer",
        "type": "integer"
      },
      "processed_cells": {
        "default": 0,
        "format": "integer",
        "type": "integer"
      },
      "started_at": {
        "format": "timestamp with time zone",
        "type": "string"
      },
      "completed_at": {
        "format": "timestamp with time zone",
        "type": "string"
      },
      "failed_at": {
        "format": "timestamp with time zone",
        "type": "string"
      },
      "error_summary": {
        "format": "text",
        "type": "string"
      },
      "created_at": {
        "default": "now()",
        "format": "timestamp with time zone",
        "type": "string"
      }
    },
    "type": "object"
  },
  "risk_predictions": {
    "description": "Per-grid-cell model outputs. Model output is advisory until reviewed/released by an authorized officer.",
    "required": [
      "id",
      "run_id",
      "grid_code",
      "risk_score",
      "risk_category",
      "model_name",
      "model_version",
      "generated_at"
    ],
    "properties": {
      "id": {
        "default": "gen_random_uuid()",
        "description": "Note:\nThis is a Primary Key.<pk/>",
        "format": "uuid",
        "type": "string"
      },
      "run_id": {
        "description": "Note:\nThis is a Foreign Key to `prediction_runs.id`.<fk table='prediction_runs' column='id'/>",
        "format": "uuid",
        "type": "string"
      },
      "grid_code": {
        "description": "Note:\nThis is a Foreign Key to `analysis_grid_cells.grid_code`.<fk table='analysis_grid_cells' column='grid_code'/>",
        "format": "text",
        "type": "string"
      },
      "risk_score": {
        "format": "numeric",
        "type": "number"
      },
      "risk_category": {
        "format": "text",
        "type": "string"
      },
      "confidence": {
        "format": "numeric",
        "type": "number"
      },
      "model_name": {
        "format": "text",
        "type": "string"
      },
      "model_version": {
        "format": "text",
        "type": "string"
      },
      "generated_at": {
        "default": "now()",
        "format": "timestamp with time zone",
        "type": "string"
      },
      "input_snapshot": {
        "format": "jsonb"
      },
      "explanation": {
        "format": "jsonb"
      }
    },
    "type": "object"
  },
  "prediction_job_events": {
    "description": "Append-style operational progress events for prediction jobs.",
    "required": [
      "id",
      "run_id",
      "event_type",
      "created_at"
    ],
    "properties": {
      "id": {
        "description": "Note:\nThis is a Primary Key.<pk/>",
        "format": "bigint",
        "type": "integer"
      },
      "run_id": {
        "description": "Note:\nThis is a Foreign Key to `prediction_runs.id`.<fk table='prediction_runs' column='id'/>",
        "format": "uuid",
        "type": "string"
      },
      "event_type": {
        "format": "text",
        "type": "string"
      },
      "message": {
        "format": "text",
        "type": "string"
      },
      "processed_cells": {
        "format": "integer",
        "type": "integer"
      },
      "total_cells": {
        "format": "integer",
        "type": "integer"
      },
      "created_at": {
        "default": "now()",
        "format": "timestamp with time zone",
        "type": "string"
      }
    },
    "type": "object"
  }
}